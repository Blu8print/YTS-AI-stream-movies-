{
  "name": "yts-ai-player",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-linux-x64 --output dist/yts-ai-player"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "webtorrent": "^1.9.7"
  }
}
